# Local credentials
*-service-account*.json
*-credentials*.json
.env
.env.local

# Local data dirs
.cache/gum/

# Generated dispatch stubs. `make stubs` emits one stub_*.go per eligible
# variant; those stay out of git. Three files in that directory are
# hand-authored and tracked, because the stubs call executeREST from
# dispatch.go and the package cannot compile without it.
apps/gum/gen/*
!apps/gum/gen/dispatch/
apps/gum/gen/dispatch/*
!apps/gum/gen/dispatch/dispatch.go
!apps/gum/gen/dispatch/dispatch_test.go
!apps/gum/gen/dispatch/variant_ids_test.go

# Go build and release artifacts
apps/gum/gum
apps/gum/gen-catalog
apps/gum/measure-tier-a
apps/gum/gen-fixtures
apps/gum/dist/
apps/gum/CHANGELOG.md
apps/gum/README.md
apps/gum/LICENSE
dist/
coverage.out
coverage.html

# Editor / OS
.DS_Store
.idea/
.vscode/
.omx/

# Go test binaries
*.test
